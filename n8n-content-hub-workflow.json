    {
      "parameters": {
        "url": "https://www.cotemaison.fr/rss",
        "options": {}
      },
      "id": "rss8",
      "name": "Côté Maison",
      "type": "n8n-nodes-base.rssFeedRead",
      "typeVersion": 1,
      "position": [450, 1150]
    },
    {
      "parameters": {
        "jsCode": "// Merge all RSS feeds\nconst items = $('Italy Dream Design').all()\n  .concat($('Materialiedesign').all())\n  .concat($('Interni Magazine').all())\n  .concat($('Design Signal').all())\n  .concat($('Dezeen').all())\n  .concat($('Furnishing Design').all())\n  .concat($('Maison&Objet').all())\n  .concat($('Côté Maison').all())\n\n// Remove duplicates by link and filter out old items (last 7 days)\nconst seen = new Set()\nconst sevenDaysAgo = Date.now() - 7 * 24 * 60 * 60 * 1000\n\nreturn items.filter(item => {\n  const link = item.json.link || item.json.url || ''\n  if (!link || seen.has(link)) return false\n  seen.add(link)\n  \n  // Check if within last 7 days\n  const pubDate = new Date(item.json.pubDate || item.json.createdAt || 0).getTime()\n  return pubDate > sevenDaysAgo\n}).map(item => ({\n  title: item.json.title || '',\n  description: item.json.description || item.json.content || '',\n  image_url: (item.json.enclosure || {}).url || \n             (item.json['media:content'] || {}).url || \n             item.json.image || \n             (item.json.content || '').match(/<img[^>]*src=\"([^\"]*)\"/)?.[1] || '',\n  source_url: item.json.link || item.json.url || '',\n  source_name: 'rss',\n  gallery: []\n}))"
      },
      "id": "merge",
      "name": "Merge & Deduplicate",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [650, 500]
    },
    {
      "parameters": {
        "url": "={{ $json['source_url'] }}",
        "options": {
          "response": {
            "response": {
              "fullResponse": true
            }
          }
        },
        "sendQuery": false,
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "title",
              "value": "={{ $json['title'] }}"
            },
            {
              "name": "description",
              "value": "={{ $json['description'] }}"
            },
            {
              "name": "image_url",
              "value": "={{ $json['image_url'] }}"
            },
            {
              "name": "source_url",
              "value": "={{ $json['source_url'] }}"
            },
            {
              "name": "source_name",
              "value": "={{ $json['source_name'] }}"
            },
            {
              "name": "gallery",
              "value": "={{ $json['gallery'] }}"
            }
          ]
        }
      },
      "id": "fetchFullContent",
      "name": "Fetch Full Article HTML",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [850, 500]
    },
    {
      "parameters": {
        "jsCode": "// Extract clean text from HTML\nconst html = $json.body || ''\n\n// Remove scripts, styles, nav, footer, header\nconst cleaned = html\n  .replace(/<script[^>]*>[\\s\\S]*?<\\/script>/gi, '')\n  .replace(/<style[^>]*>[\\s\\S]*?<\\/style>/gi, '')\n  .replace(/<nav[^>]*>[\\s\\S]*?<\\/nav>/gi, '')\n  .replace(/<footer[^>]*>[\\s\\S]*?<\\/footer>/gi, '')\n  .replace(/<header[^>]*>[\\s\\S]*?<\\/header>/gi, '')\n\n// Extract text from <article> or <main> or body\nconst article = cleaned.match(/<article[^>]*>([\\s\\S]*?)<\\/article>/i) ||\n                cleaned.match(/<main[^>]*>([\\s\\S]*?)<\\/main>/i) ||\n                [null, cleaned]\n\n// Get all images in article\nconst images = (article[1] || cleaned).match(/<img[^>]*src=\"([^\"]*)\"/g) || []\nconst gallery = images\n  .map(s => s.match(/src=\"([^\"]*)\"/)?.[1])\n  .filter(Boolean)\n  .filter(url => url.startsWith('http'))\n  .slice(0, 10)\n\n// Strip HTML to get clean text\nconst text = (article[1] || cleaned)\n  .replace(/<[^>]*>/g, ' ')\n  .replace(/\\s+/g, ' ')\n  .trim()\n  .substring(0, 3000)\n\nreturn [{\n  ...$json,\n  description: text || $json.description,\n  gallery\n}]"
      },
      "id": "extractContent",
      "name": "Extract Content & Images",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1050, 500]
    },
    {
      "parameters": {
        "url": "https://PROJECT_REF.supabase.co/functions/v1/content-hub-ingest",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "bodyParameters": {
