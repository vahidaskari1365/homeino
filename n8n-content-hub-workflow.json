      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [1250, 500]
    },
    {
      "parameters": {
        "jsCode": "// Log results\nconst results = $json.results || [$json]\nreturn results.map(r => ({\n  status: r.status || r.error ? 'failed' : 'success',\n  id: r.id || null,\n  title: r.title || 'unknown',\n  error: r.error || null\n}))"
      },
      "id": "logResults",
